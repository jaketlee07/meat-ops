# Stack B: a second local Supabase stack that only the tests use, beside stack A
# (supabase/config.toml). A folder runs on stack B when its gitignored
# supabase/.env is an exact copy of this file:
#   cp supabase/stack-b.env supabase/.env
# The Supabase CLI reads supabase/.env, and each SUPABASE_* name replaces the
# config.toml value it names. Steps: "Run two folders' tests at once" in AGENTS.md.
SUPABASE_PROJECT_ID=meat-ops-b
SUPABASE_API_PORT=55321
SUPABASE_DB_PORT=55322
SUPABASE_DB_SHADOW_PORT=55320

# The tests use only the database, auth, and REST through the API gateway.
SUPABASE_STUDIO_ENABLED=false
SUPABASE_INBUCKET_ENABLED=false
SUPABASE_STORAGE_ENABLED=false
SUPABASE_REALTIME_ENABLED=false
SUPABASE_ANALYTICS_ENABLED=false
SUPABASE_EDGE_RUNTIME_ENABLED=false
