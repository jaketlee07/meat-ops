{
  "name": "meat-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inventory, costing, and lot traceability for a meat processor.",
  "scripts": {
    "test": "vitest run",
    "test:costing": "vitest run test/costing.test.ts",
