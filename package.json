{
  "name": "meat-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inventory, costing, and lot traceability for a meat processor.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run && npm run test:e2e",
    "test:e2e": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test",
    "test:costing": "vitest run test/costing.test.ts test/pricing.test.ts",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:reset:test": "supabase db reset",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
