# No package's install code runs in this repository: npm skips every
# preinstall, install, and postinstall script, and the node-gyp build it adds
# for a package with a binding.gyp. The pre and post scripts around `npm run`
# are skipped too. To allow one package's install script, the owner runs
# `npm rebuild <package> --ignore-scripts=false`, again after each `npm ci`.
ignore-scripts=true
