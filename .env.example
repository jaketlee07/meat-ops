# The app reads only these two values, from the gitignored .env. Make that file
# from the local stack with the command in AGENTS.md. The app refuses to build,
# start, or run with any privileged variable set, such as a database URL or the
# service role key; the tests read the local stack through `supabase status`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
