# The app reads these values from the gitignored .env. Make that file from the
# local stack with the command in AGENTS.md. The app refuses to build, start, or
# run with any privileged variable set, such as a database URL or the service
# role key; the tests read the local stack through `supabase status`.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: the Anthropic API key that reads invoices on /invoices. Without it,
# a read says invoice reading isn't set up, and nothing else changes. Only server
# code reads it. The tests never use it: the browser suite gives the app its own
# test key and a fake model service on this machine.
ANTHROPIC_API_KEY=
